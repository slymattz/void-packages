From 907e53ab079062fe40d3e330c7e8a1c4c953a193 Mon Sep 17 00:00:00 2001
From: Fabio Valentini <decathorpe@gmail.com>
Date: Fri, 27 Mar 2026 00:06:13 +0100
Subject: [PATCH 02/17] Use MSRV-aware dependency resolver unconditionally

The `resolver = "3"` setting is available since Rust 1.84 and this
project has an MSRV of 1.85, so there is no reason not to use it.
---
 Cargo.toml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Cargo.toml b/Cargo.toml
index 377aa3c..cd5ed80 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -17,6 +17,7 @@ license = "LGPL-2.0-or-later"
 edition = "2021"
 build = "build.rs"
 rust-version = "1.85"
+resolver = "3"
 
 [badges]
 gitlab = { repository = "sequoia-pgp/sequoia-octopus-librnp" }
-- 
GitLab


From 51503e4d69b0de149b99fd6b7daae1afa4e05223 Mon Sep 17 00:00:00 2001
From: Fabio Valentini <decathorpe@gmail.com>
Date: Fri, 27 Mar 2026 00:07:58 +0100
Subject: [PATCH 03/17] clippy: add default lint configuration

---
 Cargo.toml | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/Cargo.toml b/Cargo.toml
index cd5ed80..fce0dee 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -91,3 +91,10 @@ crypto-cng = [
     "sequoia-openpgp/compression",
     "sequoia-openpgp/crypto-cng",
 ]
+
+[lints.clippy]
+# default clippy lint levels matching the common-ci environment:
+# https://gitlab.com/sequoia-pgp/common-ci/-/blob/main/templates/precheck.yml
+suspicious = { level = "deny", priority = -1 }
+style = { level = "allow", priority = -1 }
+complexity = { level = "allow", priority = -1 }
-- 
