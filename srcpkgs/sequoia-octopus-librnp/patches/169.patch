+// Version 0.18.1
+#[no_mangle] pub unsafe extern "C"
+fn rnp_key_get_revocation_signature(key: *mut RnpKey,
+                            sig: *mut *mut RnpSignature)
+                            -> RnpResult {
+    rnp_function!(rnp_signature_get_revocation_signature, crate::TRACE);
+    let key = assert_ptr_mut!(key);
+    let policy = (*(key.ctx)).policy().clone();
+
+    let return_status = if let Some(cert) = key.try_cert() {
+        match cert.revocation_status(&policy, None) {
+            RevocationStatus::NotAsFarAsWeKnow => RNP_SUCCESS,
+            // Unclear how RNP handles third party revocations.
+            RevocationStatus::CouldBe(_) => RNP_SUCCESS,
+            RevocationStatus::Revoked(s) => {
+                if let Some(s) = s.first() {
+                    *sig = Box::into_raw(Box::new(
+                        // Check: RevocationStatus::Revoked contains
+                        // only valid signatures
+                        RnpSignature::new(key.ctx, (*s).clone(), Some(true))));
+                    RNP_SUCCESS
+                } else {
+                    RNP_ERROR_BAD_STATE
+                }
+            }
+        }
+    } else {
+        RNP_ERROR_NO_SUITABLE_KEY
+    };
+
+    rnp_return_status!(return_status)
